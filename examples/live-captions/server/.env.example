# Copy to .env and load it with: node --env-file=.env server.mjs ...   (Node 20.6+)
# Never commit .env.

# HTTP and WebSocket port (default 8787)
PORT=8787

# Fixed room code instead of a random one (handy for a bookmarked glasses URL). 6 characters from A-Z and 2-9.
# ROOM=K7MPQ4

# Language passed to the speech-to-text adapter (BCP 47, for example en, de, ja)
STT_LANGUAGE=en

# Deepgram adapter (--stt deepgram)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
