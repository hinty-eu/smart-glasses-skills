{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hinty-eu/smart-glasses-skills/data/schema.json",
  "title": "Smart glasses platforms",
  "description": "Every fact carries its source, the date it was checked and how sure we are. Tables in the skills and the README are generated from this file by scripts/gen-tables.mjs.",
  "type": "object",
  "required": ["columns", "platforms"],
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "title": { "type": "string" } }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "scope", "facts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string" },
          "scope": { "enum": ["full", "pointer"], "description": "full = covered in depth in v1, pointer = one row plus links" },
          "reference": { "type": "string", "description": "Path of the brand file under skills/smart-glasses/references/" },
          "facts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/fact" } }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["value", "source", "checked", "confidence"],
      "properties": {
        "value": { "type": "string" },
        "source": { "type": "string", "format": "uri" },
        "checked": { "type": "string", "pattern": "^\d{4}-\d{2}-\d{2}$" },
        "confidence": { "enum": ["official", "community", "press", "unverified"] },
        "note": { "type": "string" }
      }
    }
  }
}
